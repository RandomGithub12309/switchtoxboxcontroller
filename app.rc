#include <windows.h>

#define IDI_ICON1 101
IDI_ICON1 ICON "icon.ico"

1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION     1,2,1,0
PRODUCTVERSION  1,2,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "SwitchProXInput\0"
            VALUE "FileDescription",  "Switch Pro Controller to XInput bridge\0"
            VALUE "FileVersion",      "1.2.1\0"
            VALUE "InternalName",     "SwitchProXInput\0"
            VALUE "LegalCopyright",   "MIT License\0"
            VALUE "OriginalFilename", "SwitchProXInput.exe\0"
            VALUE "ProductName",      "SwitchProXInput\0"
            VALUE "ProductVersion",   "1.2.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
